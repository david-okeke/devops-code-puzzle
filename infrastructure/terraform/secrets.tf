# Password is generated by Terraform, never typed anywhere, and stored only
# in SSM Parameter Store. It never appears in the EC2 user_data as plaintext -
# the instance fetches it at boot time using its IAM role, over the API,
# so it never sits in User Data or shows up via
# `aws ec2 describe-instance-attribute --attribute userData`.
resource "random_password" "db" {
  length      = 24
  special     = false # keeps it safe to embed in a connection string
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

resource "aws_ssm_parameter" "db_password" {
  name        = "/${local.name_prefix}/db-password"
  description = "Master password for the ${var.environment} RDS instance"
  type        = "SecureString"
  value       = random_password.db.result
}