# Password is generated by Terraform, never typed anywhere, and stored only
# in AWS Secrets Manager. It never appears in the EC2 user_data as plaintext -
# the instance fetches it at boot time using its IAM role.
resource "random_password" "db" {
  length      = 24
  special     = false # keeps it safe to embed in a connection string
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

resource "aws_secretsmanager_secret" "db" {
  name                    = "${local.name_prefix}-db-password"
  description             = "Master password for the ${var.environment} RDS instance"
  recovery_window_in_days = 0 # allows clean destroy for this evaluation
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id     = aws_secretsmanager_secret.db.id
  secret_string = random_password.db.result
}